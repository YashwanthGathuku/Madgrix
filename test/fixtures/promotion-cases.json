			"rebase": {"candidate": "X", "onto": "H2"},
			"expect": {
				"exit": 0,
				"fields": {"OUTCOME": "REBASED", "REBASED_SHA": "<new>", "ONTO": "H2"},
				"new_commit": {
					"commits_above_onto": 1,
					"files": {
						"README.md": "base\n",
						"fix.txt": "fix\n",
						"other.txt": "other\n",
						".madgrix/tool-status.jsonl": "{\"log\":\"candidate\"}\n"
					}
				},
				"fork_after": "<new>",
				"destination_after": "H2",
				"http": {"status": 200, "outcome": "REBASED"},
				"authority": {"record": "RECORDED", "permit_at_onto": "ISSUED"}
			}
		},
		{
			"name": "rebase: two candidate commits are replayed in order -> REBASED two commits above onto",
			"commits": {
				"B": {"parents": [], "files": {"README.md": "base\n"}},
				"C1": {"parents": ["B"], "files": {"README.md": "base\n", "a.txt": "a\n"}},
				"X": {"parents": ["C1"], "files": {"README.md": "base\n", "a.txt": "a\n", "b.txt": "b\n"}},
				"H2": {"parents": ["B"], "files": {"README.md": "base\n", "other.txt": "other\n"}}
			},
			"destination": "H2",
			"fork": "X",
			"rebase": {"candidate": "X", "onto": "H2"},
			"expect": {
				"exit": 0,
				"fields": {"OUTCOME": "REBASED", "REBASED_SHA": "<new>", "ONTO": "H2"},
				"new_commit": {
					"commits_above_onto": 2,
					"files": {"README.md": "base\n", "a.txt": "a\n", "b.txt": "b\n", "other.txt": "other\n"}
				},
				"fork_after": "<new>",
				"destination_after": "H2",
				"http": {"status": 200, "outcome": "REBASED"},
				"authority": {"record": "RECORDED", "permit_at_onto": "ISSUED"}
			}
		},
		{
			"name": "rebase: the candidate's own .gitattributes (merge=union) cannot turn a conflict into a merge",
			"commits": {
				"B": {"parents": [], "files": {"README.md": "base\n"}},
				"C1": {"parents": ["B"], "files": {"README.md": "base\n", ".gitattributes": "* merge=union\n"}},
				"X": {"parents": ["C1"], "files": {"README.md": "candidate\n", ".gitattributes": "* merge=union\n"}},
				"H2": {"parents": ["B"], "files": {"README.md": "destination\n"}}
			},
			"destination": "H2",
			"fork": "X",
			"rebase": {"candidate": "X", "onto": "H2"},
			"expect": {
				"exit": 49,
				"fields": {"OUTCOME": "CONFLICT", "ONTO": "H2", "CONFLICT_PATHS": ["README.md"]},
				"fork_after": "X",
				"destination_after": "H2",
				"http": {"status": 409, "outcome": "CONFLICT", "paths": ["README.md"]},
				"authority": {"record": "ESCALATED", "permit_at_onto": "BLOCKED"}
			}
		},
		{
			"name": "rebase: the fork refuses the push -> PUSH_REJECTED",
			"commits": {
				"B": {"parents": [], "files": {"README.md": "base\n"}},
				"X": {"parents": ["B"], "files": {"README.md": "base\n", "fix.txt": "fix\n"}},
				"H2": {"parents": ["B"], "files": {"README.md": "base\n", "other.txt": "other\n"}}
			},
			"destination": "H2",
			"fork": "X",
			"fork_rejects_push": true,
			"rebase": {"candidate": "X", "onto": "H2"},
			"expect": {
				"exit": 44,
				"fields": {"OUTCOME": "PUSH_REJECTED"},
				"fork_after": "X",
				"destination_after": "H2",
				"http": {"status": 409, "outcome": "PUSH_REJECTED"},
				"authority": {"record": null, "permit_at_onto": "REBASE_REQUIRED"}
			}
		},
		{
			"name": "rebase: the contender pushes just before the rebase's push -> PUSH_REJECTED; the contender's commit stands",
			"commits": {
				"B": {"parents": [], "files": {"README.md": "base\n"}},
				"X": {"parents": ["B"], "files": {"README.md": "base\n", "fix.txt": "fix\n"}},
				"Y": {"parents": ["X"], "files": {"README.md": "base\n", "fix.txt": "fix\n", "more.txt": "more\n"}},
				"H2": {"parents": ["B"], "files": {"README.md": "base\n", "other.txt": "other\n"}}
			},
			"destination": "H2",
			"fork": "X",
			"fork_moves_during_push_to": "Y",
			"rebase": {"candidate": "X", "onto": "H2"},
			"expect": {
				"exit": 44,
				"fields": {"OUTCOME": "PUSH_REJECTED"},
				"fork_after": "Y",
				"destination_after": "H2",
				"http": {"status": 409, "outcome": "PUSH_REJECTED"},
				"authority": {"record": null, "permit_at_onto": "REBASE_REQUIRED"}
			}
		}
	]
}
