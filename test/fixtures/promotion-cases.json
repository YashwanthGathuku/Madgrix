					"files": {
						"README.md": "base\n",
						"docs/release notes.md": "v1 dest\n",
						"weird\nname.txt": "w1 dest\n",
						"src/ünï.js": "u1 dest\n"
					}
				}
			},
			"destination": "H2",
			"fork": "X",
			"rebase": {"candidate": "X", "onto": "H2"},
			"expect": {
				"exit": 49,
				"fields": {
					"OUTCOME": "CONFLICT",
					"ONTO": "H2",
					"CONFLICT_PATHS": ["docs/release notes.md", "src/ünï.js", "weird\nname.txt"]
				},
				"fork_after": "X",
				"destination_after": "H2",
				"http": {
					"status": 409,
					"outcome": "CONFLICT",
