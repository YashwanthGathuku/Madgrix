			}
		},
		{
			"name": "rebase: conflict paths are data (a space, a newline, non-ASCII)",
			"commits": {
				"B": {
					"parents": [],
					"files": {
						"README.md": "base\n",
						"docs/release notes.md": "v1\n",
						"weird\nname.txt": "w1\n",
						"src/ünï.js": "u1\n"
					}
				},
				"X": {
					"parents": ["B"],
					"files": {
						"README.md": "base\n",
						"docs/release notes.md": "v1 cand\n",
						"weird\nname.txt": "w1 cand\n",
						"src/ünï.js": "u1 cand\n"
					}
				},
				"H2": {
